# Environment variable example for .env file

# Status Message Configuration

# Number of downloads to show per page in the consolidated status message
# Default: 5
# Increase this if you want more downloads visible at once
# Decrease this if you want fewer downloads per page
STATUS_ITEMS_PER_PAGE=5

# Progress update interval in seconds
# Default: 5
# How often the consolidated status message is updated
# Lower = more frequent updates (but more API calls)
# Higher = less frequent updates (saves API calls)
PROGRESS_UPDATE_INTERVAL=5
