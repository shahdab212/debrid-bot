# Environment Configuration

# Required: Telegram Bot Configuration
API_ID=your_api_id_here
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# Required: Debrid-Link API Key
DEBRID_KEY=your_debrid_api_key_here

# Required: Admin User IDs (comma-separated)
ADMIN_IDS=123456789,987654321

# Optional: Cloudflare Worker URL (for IP protection)
# After deploying the Cloudflare Worker, add your worker URL here
# Example: WORKER_URL=https://debrid-proxy.your-subdomain.workers.dev
# WORKER_URL=

# Optional: Web Server Base URL (for web streaming)
# Auto-detected from RENDER_EXTERNAL_URL on Render deployments
# Only set this manually if deploying to a custom domain or different platform
# Example: WEB_BASE_URL=https://your-bot-domain.com
# WEB_BASE_URL=

# Optional: Database URL (for persistent storage)
# By default, the bot uses SQLite stored in ./data/bot.db
# For production on Render, use PostgreSQL for persistence across deployments
# Example PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=
